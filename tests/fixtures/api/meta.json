    "limits": {
      "pushMutations": 50,
      "pushBytes": 1048576,
      "pageRows": 1000,
      "bodiesPerRequest": 25,
      "horizonDays": 30,
      "readingLanguages": [
        "zh-Hans",
        "zh-Hant",
        "en",
        "fr"
      ],
      "translationsPerDay": 20,
      "feedsPerDay": 20,
      "maxSubscriptions": 300,
      "unsubscribedPostsPerDay": 100
