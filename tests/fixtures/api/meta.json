{
  "request": {
    "method": "GET",
    "path": "/meta"
  },
  "status": 200,
  "headers": {
    "cache-control": "public, max-age=300"
  },
  "body": {
    "api": "tela",
    "current": 1,
    "oldest": 1,
    "versions": [
      {
        "version": 1,
        "status": "preview",
        "sunsetAt": null
      }
    ],
    "features": {
      "v1": [
        "sync",
        "mutations",
        "bodies",
        "translations",
        "feeds",
        "discover",
        "sites",
        "profiles",
        "blogrolls",
        "search",
        "articles"
      ]
